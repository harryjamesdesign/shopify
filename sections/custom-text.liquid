{%- style -%}

.custom-text-{{ section.id }} {
font-size: {{ section.settings.font_size }}px;
text-align: {{ section.settings.text_alignment }};
color: {{ section.settings.text_color }};
margin: 0;
line-height: 1.4;
padding : 8.5px 0px;
font-family: Helvetica;
font-weight: 400;
font-style: Regular;
font-size: 16px;
line-height: 21px;
letter-spacing: 0%;
text-align: center;
vertical-align: middle;
color: #FFFFFF;
background-color : #00AAEF;
}

@media screen and (max-width : 1430px) {
.list-menu {
transition: 0.5s;
gap : 20px !important;
}
}

@media screen and (max-width : 1320px) {
.list-menu{
transition : 0.5s;
gap : 0px !important;
}
}

@media screen and (max-width : 1225px) {
.header__menu-item span{
font-size : 15px;
}

}

@media screen and (max-width : 1135px) {
.header__menu-item span{
font-size : 13px;
}
}

@media screen and (max-width : 1070px) {
#HeaderMenu-bed-climate-systems span{
padding:0px !important;
}
}

@media screen and (max-width : 1015px) {
.header__menu-item{
padding : 1rem;
}

.header_menu-item:last-child{
padding : 1.5rem !important;
}
}

@media screen and (max-width : 989px) {
.header__inline-menu>ul>li {
margin-left: -1.2rem;
grid-area: navigation;
display: none !important;
}

.header__inline-menu>ul>li:last-child {
display : block !important;
}

}

@media screen and (max-width: 749px) {
.custom-text-{{ section.id }} {
font-size: {{ section.settings.font_size_mobile | default: section.settings.font_size }}px;
}
}

.list-menu{
gap: 40px;
}

@media screen and (max-width: 600px) {
header-drawer{
position : absolute;
right : 50px;
}

.header__inline-menu{
margin-right : 33%;
}

}

@media screen and (max-width: 515px) {
.header{
padding : 0px !important;
}
}

{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
    <div class="page-width">
        {% if section.settings.text_before != blank or section.settings.text_bold != blank or
        section.settings.text_after != blank %}
        <p class="custom-text-{{ section.id }}">
            {{ section.settings.text_before }}{% if section.settings.text_bold != blank %}<strong
                style="font-weight: 200 ; padding: 0px 8px; ">{{
                section.settings.text_bold }}</strong>{% endif %}{{ section.settings.text_after }}
        </p>
        {% endif %}
    </div>
</section>

{% schema %}
{
"name": "t:sections.custom-text.name",
"tag": "section",
"class": "section",
"settings": [
{
"type": "text",
"id": "text_before",
"default": "Text before ",
"label": "t:sections.custom-text.settings.text_before.label"
},
{
"type": "text",
"id": "text_bold",
"default": "bold text",
"label": "t:sections.custom-text.settings.text_bold.label"
},
{
"type": "text",
"id": "text_after",
"default": " text after",
"label": "t:sections.custom-text.settings.text_after.label"
},
{
"type": "range",
"id": "font_size",
"min": 12,
"max": 72,
"step": 1,
"unit": "px",
"label": "t:sections.custom-text.settings.font_size.label",
"default": 16
},
{
"type": "range",
"id": "font_size_mobile",
"min": 12,
"max": 48,
"step": 1,
"unit": "px",
"label": "t:sections.custom-text.settings.font_size_mobile.label",
"default": 14
},
{
"type": "select",
"id": "text_alignment",
"options": [
{
"value": "left",
"label": "t:sections.custom-text.settings.text_alignment.options__1.label"
},
{
"value": "center",
"label": "t:sections.custom-text.settings.text_alignment.options__2.label"
},
{
"value": "right",
"label": "t:sections.custom-text.settings.text_alignment.options__3.label"
}
],
"default": "left",
"label": "t:sections.custom-text.settings.text_alignment.label"
},
{
"type": "color",
"id": "text_color",
"label": "t:sections.custom-text.settings.text_color.label",
"default": "#000000"
},
{
"type": "color",
"id": "bold_text_color",
"label": "t:sections.custom-text.settings.bold_text_color.label",
"default": "#000000"
},
{
"type": "header",
"content": "t:sections.all.padding.section_padding_heading"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "t:sections.all.padding.padding_top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "t:sections.all.padding.padding_bottom",
"default": 36
}
],
"presets": [
{
"name": "t:sections.custom-text.presets.name"
}
]
}
{% endschema %}